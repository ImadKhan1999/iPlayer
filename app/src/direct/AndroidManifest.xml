<?xml version="1.0" encoding="utf-8"?>
<!-- Direct (GitHub) distribution only: self-updates and optional all-files access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the user approve installing a verified iPlayer update. Never used silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Optional, user-granted in system settings: finds external subtitles next to videos. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application>
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
